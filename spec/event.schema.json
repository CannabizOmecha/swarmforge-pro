{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/event.schema.json",
  "title": "AEGIS minimized telemetry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_id",
    "property_id",
    "outcome",
    "latency_ms",
    "attributes"
  ],
  "properties": {
    "test_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "property_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "simulated_policy_violation",
        "error",
        "inconclusive"
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status_code": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "operation": {
          "type": "string",
          "maxLength": 64
        },
        "latency_bucket": {
          "type": "string",
          "maxLength": 32
        },
        "property_id": {
          "type": "string",
          "maxLength": 64
        },
        "outcome": {
          "type": "string",
          "maxLength": 64
        },
        "service_version": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  }
}
